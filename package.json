{
  "name": "towerofcode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sync:codelife": "node scripts/sync-codelife.mjs && python3 scripts/check-grading.py --write",
    "check:grading": "python3 scripts/check-grading.py --write",
    "check:tower": "node --experimental-strip-types --no-warnings scripts/check-tower.mjs",
    "art": "node --experimental-strip-types --no-warnings scripts/draw-art.mjs",
    "art:preview": "node --experimental-strip-types --no-warnings scripts/draw-art.mjs --preview",
    "check:story": "node --experimental-strip-types --no-warnings scripts/check-story.mjs"
  },
  "devDependencies": {
    "canvas": "^3.2.2",
    "opentype.js": "^1.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.16",
    "codemirror": "^6.0.2",
    "phaser": "^3.90.0"
  }
}
